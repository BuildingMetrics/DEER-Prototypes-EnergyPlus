! === EMS PROGRAM FOR MINIMUM OA FRACTION CONTROL (BASELINE) ===
! Reheat: DISABLED in cooling mode
EnergyManagementSystem:Program,
  MinOAFractionControl,    !- Name
  ! Control logic for each zone
  ! Economizer enabled when: 7.22°C (45°F) < ODB < 17.22°C (63°F)
  ! Design minimum OA fraction calculated from Controller:OutdoorAir sizing

  ! --- Hall EL1 Core Spc (G.C5) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_HallG > 0,
    SET DesignMinFrac_HallG = DesignMinOA_HallG / DesignMaxOA_HallG,
  ELSE,
    SET DesignMinFrac_HallG = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_HallG < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_HallG = 0.35,
    SET OA_Max_Frac_Sched_HallG = 0.65,
    SET OA_Frac_Out_HallG = 0.35,
    SET Heating_Avail_HallG = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_HallG < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_HallG = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_HallG = 0.65,
        SET OA_Max_Frac_Sched_HallG = 0.65,
        SET OA_Frac_Out_HallG = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_HallG = @Min (DesignMinFrac_HallG + 0.15) 0.65,
        SET OA_Max_Frac_Sched_HallG = 0.65,
        SET OA_Frac_Out_HallG = OA_Min_Frac_Sched_HallG,
      ENDIF,
    ELSEIF ZoneLoad_HallG > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_HallG = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_HallG = @Min (DesignMinFrac_HallG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_HallG = 0.65,
      SET OA_Frac_Out_HallG = OA_Min_Frac_Sched_HallG,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_HallG = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_HallG = @Min (DesignMinFrac_HallG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_HallG = 0.65,
      SET OA_Frac_Out_HallG = OA_Min_Frac_Sched_HallG,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 North Perim Spc (G.N3) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_NorthG > 0,
    SET DesignMinFrac_NorthG = DesignMinOA_NorthG / DesignMaxOA_NorthG,
  ELSE,
    SET DesignMinFrac_NorthG = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_NorthG < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_NorthG = 0.35,
    SET OA_Max_Frac_Sched_NorthG = 0.65,
    SET OA_Frac_Out_NorthG = 0.35,
    SET Heating_Avail_NorthG = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_NorthG < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_NorthG = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_NorthG = 0.65,
        SET OA_Max_Frac_Sched_NorthG = 0.65,
        SET OA_Frac_Out_NorthG = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_NorthG = @Min (DesignMinFrac_NorthG + 0.15) 0.65,
        SET OA_Max_Frac_Sched_NorthG = 0.65,
        SET OA_Frac_Out_NorthG = OA_Min_Frac_Sched_NorthG,
      ENDIF,
    ELSEIF ZoneLoad_NorthG > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_NorthG = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_NorthG = @Min (DesignMinFrac_NorthG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_NorthG = 0.65,
      SET OA_Frac_Out_NorthG = OA_Min_Frac_Sched_NorthG,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_NorthG = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_NorthG = @Min (DesignMinFrac_NorthG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_NorthG = 0.65,
      SET OA_Frac_Out_NorthG = OA_Min_Frac_Sched_NorthG,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 East Perim Spc (G.E2) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_EastG > 0,
    SET DesignMinFrac_EastG = DesignMinOA_EastG / DesignMaxOA_EastG,
  ELSE,
    SET DesignMinFrac_EastG = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_EastG < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_EastG = 0.35,
    SET OA_Max_Frac_Sched_EastG = 0.65,
    SET OA_Frac_Out_EastG = 0.35,
    SET Heating_Avail_EastG = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_EastG < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_EastG = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_EastG = 0.65,
        SET OA_Max_Frac_Sched_EastG = 0.65,
        SET OA_Frac_Out_EastG = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_EastG = @Min (DesignMinFrac_EastG + 0.15) 0.65,
        SET OA_Max_Frac_Sched_EastG = 0.65,
        SET OA_Frac_Out_EastG = OA_Min_Frac_Sched_EastG,
      ENDIF,
    ELSEIF ZoneLoad_EastG > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_EastG = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_EastG = @Min (DesignMinFrac_EastG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_EastG = 0.65,
      SET OA_Frac_Out_EastG = OA_Min_Frac_Sched_EastG,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_EastG = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_EastG = @Min (DesignMinFrac_EastG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_EastG = 0.65,
      SET OA_Frac_Out_EastG = OA_Min_Frac_Sched_EastG,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 South Perim Spc (G.S1) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_SouthG > 0,
    SET DesignMinFrac_SouthG = DesignMinOA_SouthG / DesignMaxOA_SouthG,
  ELSE,
    SET DesignMinFrac_SouthG = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_SouthG < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_SouthG = 0.35,
    SET OA_Max_Frac_Sched_SouthG = 0.65,
    SET OA_Frac_Out_SouthG = 0.35,
    SET Heating_Avail_SouthG = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_SouthG < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_SouthG = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_SouthG = 0.65,
        SET OA_Max_Frac_Sched_SouthG = 0.65,
        SET OA_Frac_Out_SouthG = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_SouthG = @Min (DesignMinFrac_SouthG + 0.15) 0.65,
        SET OA_Max_Frac_Sched_SouthG = 0.65,
        SET OA_Frac_Out_SouthG = OA_Min_Frac_Sched_SouthG,
      ENDIF,
    ELSEIF ZoneLoad_SouthG > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_SouthG = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_SouthG = @Min (DesignMinFrac_SouthG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_SouthG = 0.65,
      SET OA_Frac_Out_SouthG = OA_Min_Frac_Sched_SouthG,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_SouthG = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_SouthG = @Min (DesignMinFrac_SouthG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_SouthG = 0.65,
      SET OA_Frac_Out_SouthG = OA_Min_Frac_Sched_SouthG,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 West Perim Spc (G.W4) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_WestG > 0,
    SET DesignMinFrac_WestG = DesignMinOA_WestG / DesignMaxOA_WestG,
  ELSE,
    SET DesignMinFrac_WestG = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_WestG < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_WestG = 0.35,
    SET OA_Max_Frac_Sched_WestG = 0.65,
    SET OA_Frac_Out_WestG = 0.35,
    SET Heating_Avail_WestG = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_WestG < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_WestG = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_WestG = 0.65,
        SET OA_Max_Frac_Sched_WestG = 0.65,
        SET OA_Frac_Out_WestG = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_WestG = @Min (DesignMinFrac_WestG + 0.15) 0.65,
        SET OA_Max_Frac_Sched_WestG = 0.65,
        SET OA_Frac_Out_WestG = OA_Min_Frac_Sched_WestG,
      ENDIF,
    ELSEIF ZoneLoad_WestG > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_WestG = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_WestG = @Min (DesignMinFrac_WestG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_WestG = 0.65,
      SET OA_Frac_Out_WestG = OA_Min_Frac_Sched_WestG,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_WestG = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_WestG = @Min (DesignMinFrac_WestG + 0.15) 0.65,
      SET OA_Max_Frac_Sched_WestG = 0.65,
      SET OA_Frac_Out_WestG = OA_Min_Frac_Sched_WestG,
    ENDIF,
  ENDIF,

  ! --- Hall EL1 Core Spc (T.C15) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_HallT > 0,
    SET DesignMinFrac_HallT = DesignMinOA_HallT / DesignMaxOA_HallT,
  ELSE,
    SET DesignMinFrac_HallT = 0.20,  ! Fallback if sizing not available
