      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_NorthT = @Min (DesignMinFrac_NorthT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_NorthT = 0.65,
      SET OA_Frac_Out_NorthT = OA_Min_Frac_Sched_NorthT,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_NorthT = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_NorthT = @Min (DesignMinFrac_NorthT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_NorthT = 0.65,
      SET OA_Frac_Out_NorthT = OA_Min_Frac_Sched_NorthT,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 East Perim Spc (T.E12) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_EastT > 0,
    SET DesignMinFrac_EastT = DesignMinOA_EastT / DesignMaxOA_EastT,
  ELSE,
    SET DesignMinFrac_EastT = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_EastT < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_EastT = 0.35,
    SET OA_Max_Frac_Sched_EastT = 0.65,
    SET OA_Frac_Out_EastT = 0.35,
    SET Heating_Avail_EastT = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_EastT < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_EastT = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_EastT = 0.65,
        SET OA_Max_Frac_Sched_EastT = 0.65,
        SET OA_Frac_Out_EastT = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_EastT = @Min (DesignMinFrac_EastT + 0.15) 0.65,
        SET OA_Max_Frac_Sched_EastT = 0.65,
        SET OA_Frac_Out_EastT = OA_Min_Frac_Sched_EastT,
      ENDIF,
    ELSEIF ZoneLoad_EastT > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_EastT = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_EastT = @Min (DesignMinFrac_EastT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_EastT = 0.65,
      SET OA_Frac_Out_EastT = OA_Min_Frac_Sched_EastT,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_EastT = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_EastT = @Min (DesignMinFrac_EastT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_EastT = 0.65,
      SET OA_Frac_Out_EastT = OA_Min_Frac_Sched_EastT,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 South Perim Spc (T.S11) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_SouthT > 0,
    SET DesignMinFrac_SouthT = DesignMinOA_SouthT / DesignMaxOA_SouthT,
  ELSE,
    SET DesignMinFrac_SouthT = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_SouthT < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_SouthT = 0.35,
    SET OA_Max_Frac_Sched_SouthT = 0.65,
    SET OA_Frac_Out_SouthT = 0.35,
    SET Heating_Avail_SouthT = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_SouthT < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_SouthT = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_SouthT = 0.65,
        SET OA_Max_Frac_Sched_SouthT = 0.65,
        SET OA_Frac_Out_SouthT = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_SouthT = @Min (DesignMinFrac_SouthT + 0.15) 0.65,
        SET OA_Max_Frac_Sched_SouthT = 0.65,
        SET OA_Frac_Out_SouthT = OA_Min_Frac_Sched_SouthT,
      ENDIF,
    ELSEIF ZoneLoad_SouthT > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_SouthT = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_SouthT = @Min (DesignMinFrac_SouthT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_SouthT = 0.65,
      SET OA_Frac_Out_SouthT = OA_Min_Frac_Sched_SouthT,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_SouthT = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_SouthT = @Min (DesignMinFrac_SouthT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_SouthT = 0.65,
      SET OA_Frac_Out_SouthT = OA_Min_Frac_Sched_SouthT,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 West Perim Spc (T.W14) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_WestT > 0,
    SET DesignMinFrac_WestT = DesignMinOA_WestT / DesignMaxOA_WestT,
  ELSE,
    SET DesignMinFrac_WestT = 0.20,  ! Fallback if sizing not available
  ENDIF,

  IF FanSched_WestT < 0.5,
    ! Fan schedule is OFF (unoccupied hours) - use 35% min, 65% max
    SET OA_Min_Frac_Sched_WestT = 0.35,
    SET OA_Max_Frac_Sched_WestT = 0.65,
    SET OA_Frac_Out_WestT = 0.35,
    SET Heating_Avail_WestT = 1,
  ELSE,
    ! Fan schedule is ON (occupied hours)
    IF ZoneLoad_WestT < 0,
      ! Cooling mode: disable reheat
      SET Heating_Avail_WestT = 0,
      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_WestT = 0.65,
        SET OA_Max_Frac_Sched_WestT = 0.65,
        SET OA_Frac_Out_WestT = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_WestT = @Min (DesignMinFrac_WestT + 0.15) 0.65,
        SET OA_Max_Frac_Sched_WestT = 0.65,
        SET OA_Frac_Out_WestT = OA_Min_Frac_Sched_WestT,
      ENDIF,
    ELSEIF ZoneLoad_WestT > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_WestT = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_WestT = @Min (DesignMinFrac_WestT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_WestT = 0.65,
      SET OA_Frac_Out_WestT = OA_Min_Frac_Sched_WestT,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_WestT = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_WestT = @Min (DesignMinFrac_WestT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_WestT = 0.65,
      SET OA_Frac_Out_WestT = OA_Min_Frac_Sched_WestT,
    ENDIF,
  ENDIF,

  ;  !- End of program

! === PROGRAM CALLING MANAGER ===
EnergyManagementSystem:ProgramCallingManager,
  MinOAFractionManager,    !- Name
  AfterPredictorBeforeHVACManagers,  !- EnergyPlus Model Calling Point
  MinOAFractionControl;    !- Program Name


