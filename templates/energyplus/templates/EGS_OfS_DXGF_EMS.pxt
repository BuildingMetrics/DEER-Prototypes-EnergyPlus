!-   ===========  UNIFIED EMS ECONOMIZER CONTROL (BASELINE) ===========
!    This approach uses EMS to actuate the Minimum Fraction of Outdoor Air schedule.
!    Design minimum OA fraction is obtained from Controller:OutdoorAir sizing.
!
!    Parameters for Baseline:
!    - Unoccupied hours: 35%
!    - Heating mode: min(design_min + 15%, 65%)
!    - Neutral load: min(design_min + 15%, 65%)
!    - Cooling (econ disabled): min(design_min + 15%, 65%)
!    - Economizer: 65%
!    - Reheat: DISABLED in cooling mode


Schedule:Constant,
  Hall EL1 Core Spc (G.C5) Min OA Fraction Schedule,  !- Name
  Unit Interval,           !- Schedule Type Limits Name
  0.20;                    !- Value (placeholder - EMS will override)

EnergyManagementSystem:Actuator,
  OA_Min_Frac_Sched_HallG,          !- Name
  Hall EL1 Core Spc (G.C5) Min OA Fraction Schedule,  !- Actuated Component Unique Name
  Schedule:Constant,       !- Actuated Component Type
  Schedule Value;          !- Actuated Component Control Type


Schedule:Constant,
  OfficeSmall EL1 North Perim Spc (G.N3) Min OA Fraction Schedule,  !- Name
  Unit Interval,           !- Schedule Type Limits Name
  0.20;                    !- Value (placeholder - EMS will override)

EnergyManagementSystem:Actuator,
  OA_Min_Frac_Sched_NorthG,          !- Name
  OfficeSmall EL1 North Perim Spc (G.N3) Min OA Fraction Schedule,  !- Actuated Component Unique Name
  Schedule:Constant,       !- Actuated Component Type
  Schedule Value;          !- Actuated Component Control Type


Schedule:Constant,
  OfficeSmall EL1 East Perim Spc (G.E2) Min OA Fraction Schedule,  !- Name
  Unit Interval,           !- Schedule Type Limits Name
  0.20;                    !- Value (placeholder - EMS will override)

