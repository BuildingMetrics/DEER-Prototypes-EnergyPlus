      ! Cooling needed - check economizer conditions
      IF (OutdoorDryBulb > 7.22) && (OutdoorDryBulb < 17.22),
        ! Economizer enabled - 65% max OA
        SET OA_Min_Frac_Sched_HallT = 0.65,
        SET OA_Max_Frac_Sched_HallT = 0.65,
        SET OA_Frac_Out_HallT = 0.65,
      ELSE,
        ! Economizer disabled - min(design_min + 15%, 65%)
        SET OA_Min_Frac_Sched_HallT = @Min (DesignMinFrac_HallT + 0.15) 0.65,
        SET OA_Max_Frac_Sched_HallT = 0.65,
        SET OA_Frac_Out_HallT = OA_Min_Frac_Sched_HallT,
      ENDIF,
    ELSEIF ZoneLoad_HallT > 0,
      ! Heating mode: enable heating
      SET Heating_Avail_HallT = 1,
      ! Heating needed - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_HallT = @Min (DesignMinFrac_HallT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_HallT = 0.65,
      SET OA_Frac_Out_HallT = OA_Min_Frac_Sched_HallT,
    ELSE,
      ! No load: enable heating
      SET Heating_Avail_HallT = 1,
      ! No significant load - min(design_min + 15%, 65%)
      SET OA_Min_Frac_Sched_HallT = @Min (DesignMinFrac_HallT + 0.15) 0.65,
      SET OA_Max_Frac_Sched_HallT = 0.65,
      SET OA_Frac_Out_HallT = OA_Min_Frac_Sched_HallT,
    ENDIF,
  ENDIF,

  ! --- OfficeSmall EL1 North Perim Spc (T.N13) ---
  ! Calculate design minimum OA fraction from sizing
  IF DesignMaxOA_NorthT > 0,
    SET DesignMinFrac_NorthT = DesignMinOA_NorthT / DesignMaxOA_NorthT,
  ELSE,
