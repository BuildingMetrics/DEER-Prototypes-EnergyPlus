<%#INITIALIZE
require "modelkit/energyplus"

parameter "zone_name"
parameter "main_hvac_type"
%>

EnergyManagementSystem:Sensor,
  ZoneLoad_<%= ((zone_name.split(" ")).join("_")).delete("\.()") %>,              !- Name
  <%= zone_name %>,                       !- Output:Variable or Output:Meter Index Key Name
  Zone Predicted Sensible Load to Setpoint Heat Transfer Rate;  !- Output:Variable or Output:Meter Name

EnergyManagementSystem:Sensor,
  FanSched_<%= ((zone_name.split(" ")).join("_")).delete("\.()") %>,              !- Name
  <%= zone_name %> <%= main_hvac_type %> Operation Schedule,  !- Output:Variable or Output:Meter Index Key Name
  Schedule Value;  !- Output:Variable or Output:Meter Name